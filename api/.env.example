# HTTP server
PORT=3001

# PostgreSQL connection used by the current backend
DB_DEPLOY=postgresql://user:password@localhost:5432/chilly

# Database lifecycle. Destructive reset is only accepted when both are true.
DEMO_MODE=true
RESET_DB_ON_START=true

# Stripe Checkout (test mode only for the portfolio demo)
STRIPE_SECRET_KEY=sk_test_your_key
STOREFRONT_URL=http://localhost:3000/PF-Chilly/

# Auth0 API validation
AUTH0_AUDIENCE=https://chilly-api
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com/
AUTH0_ADMIN_SCOPE=admin:access
